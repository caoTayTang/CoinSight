# Copy to .env and adjust if needed: cp .env.example .env
# Values here are seen from inside Docker containers (host "postgres",
# paths under /data). Make targets that run on the host (make extract,
# make batch, make test) switch to localhost and repository paths themselves.

# PostgreSQL warehouse
POSTGRES_DB=crypto_dw
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crypto:crypto@postgres:5432/crypto_dw
SAMPLE_CSV=/data/sample.csv

# Runtime endpoints, paths, and credentials. Coin lists, intervals, timing,
# thresholds and schedules are in pipeline/settings.yaml.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Binance live is the Compose default. Replay is opt-in with `make stream`.
LIVE_KAFKA_TOPIC=crypto-prices-live
STREAM_KAFKA_TOPIC=crypto-prices-live
REPLAY_KAFKA_TOPIC=crypto-prices-replay
REPLAY_CSV=/data/raw/Crypto_historical_data.csv
STREAM_CHECKPOINT_PATH=/checkpoints/live-metrics-v2
BINANCE_API_URL=https://data-api.binance.vision
BINANCE_WS_URL=wss://stream.binance.com:9443
LIVE_STATE_FILE=/state/live-producer.json

# Batch archive endpoint
BINANCE_DATA_URL=https://data.binance.vision

# Airflow runs as this host user id so it can write data/raw; check with: id -u
AIRFLOW_UID=1000

# Optional Bedrock Converse model ID or inference profile ARN for /v1/agent/chat.
# Lower-cost example, Claude Haiku 4.5 in us-east-1: global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=... (or use standard AWS credentials)

# API trace export; Jaeger UI: http://localhost:16686 (local development).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces

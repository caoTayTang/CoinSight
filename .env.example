# Copy to .env and adjust if needed: cp .env.example .env
# Values here are seen from inside Docker containers (host "postgres",
# paths under /data). Make targets that run on the host (make extract,
# make batch, make test) switch to localhost and repository paths themselves.

# PostgreSQL warehouse
POSTGRES_DB=crypto_dw
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crypto:crypto@postgres:5432/crypto_dw

# Runtime endpoints, paths, and credentials. Coin lists, intervals, timing,
# thresholds and schedules are in pipeline/settings.yaml.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
LIVE_KAFKA_TOPIC=crypto-prices-live
STREAM_KAFKA_TOPIC=crypto-prices-live
STREAM_CHECKPOINT_PATH=/checkpoints/live-metrics-v2
BINANCE_API_URL=https://data-api.binance.vision
BINANCE_WS_URL=wss://stream.binance.com:9443
LIVE_STATE_FILE=/state/live-producer.json

# Batch archive endpoint
BINANCE_DATA_URL=https://data.binance.vision

# Airflow runs as this host user id so it can write data/raw; check with: id -u
AIRFLOW_UID=1000

# Bedrock: the router's last fallback (Claude Haiku 4.5). Bearer token, or leave empty to use standard
# AWS credentials.
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=

# LLM router keys for the @trade/@sre agents and the eval. warehouse_agents/router.json and
# evals/routes.json name these variables; never put a key in those files. Leave unused ones empty.
# A variable may hold a list: GROQ_API_KEY=["gsk_...","gsk_..."] (or comma-separated). The router turns
# each key into its own slot and rotates between them. Groq limits are per account, so extra keys
# only add capacity when they belong to different accounts.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# API trace export; Jaeger UI: http://localhost:16686 (local development).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces

# Self-hosted vLLM on Modal (deploy/modal/vllm_app.py): same value as the Modal secret coinsight-vllm.
SELFHOSTED_API_KEY=

# Sign-in for a deployed Desk (Cloudflare Access in front of the app). Leave empty for local use: every
# request is then the single user 'local'. TEAM_DOMAIN looks like coinsight.cloudflareaccess.com; AUD is the
# Access application's audience tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Sign-in with Supabase (Google or GitHub). Both values are public: Project Settings -> API keys. Never put the
# secret / service_role key here. With SUPABASE_URL set, visitors without a sign-in are anonymous (keyed by IP).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROVIDERS=google,github

# Agent limits per signed-in user (app/usage.py). Owners have none. Paid models (Haiku) are open to others
# for AGENT_PAID_DAILY_LIMIT questions a day until today's paid spend across all users reaches the budget.
AGENT_OWNER_EMAILS=
AGENT_DAILY_LIMIT=20
AGENT_MINUTE_LIMIT=4
AGENT_PAID_DAILY_LIMIT=5
AGENT_PAID_DAILY_BUDGET_USD=1
# Anonymous visitors: free models only, this many questions a day each and in total.
AGENT_ANON_DAILY_LIMIT=5
AGENT_ANON_GLOBAL_DAILY_LIMIT=200

# Agents' long-term user memory and the hourly prediction ledger (writable connections).
# AGENT_STATE_DATABASE_URL=postgresql://crypto:crypto@host.docker.internal:5432/crypto_dw
# LEDGER_DATABASE_URL=postgresql://crypto:crypto@host.docker.internal:5432/crypto_dw
